# ── Evigauge observability ─────────────────────────────────────────────
# Fill these in; NEVER commit real values. Copy to .env (gitignored) locally.
# The workspace API key (opx_live_… / opx_test_…) — treat as a secret.
EVIGAUGE_ORG_ID=
EVIGAUGE_WORKSPACE_ID=
# Project slug from the dashboard's Projects page (unknown slugs land in the default project).
EVIGAUGE_PROJECT_ID=default
EVIGAUGE_API_KEY=
EVIGAUGE_INGEST_URL=https://ingest.evigauge.ai

# evigauge-trace Python SDK only: "direct" (POST straight to ingest, no collector)
# or "collector" (OTLP/gRPC to a collector you run). Default here is direct.
EVIGAUGE_TRANSPORT=direct

# ── Native OpenTelemetry export (Route 0: Next.js / Node / OTel-Python) ──
# Only needed on the native-OTLP route. Derived from the values above so the
# two never disagree. MUST be http/json — protobuf export returns 415.
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.evigauge.ai
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_HEADERS=x-evigauge-api-key=REPLACE_WITH_EVIGAUGE_API_KEY
